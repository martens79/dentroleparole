# Modulo contatti con endpoint server-side (/api/contatti)
# NON inserire valori reali in questo file. Su Vercel le variabili si impostano nel pannello
# (Settings > Environment Variables), con tipo "Secret" per SMTP_PASS e CONTACT_FORM_SECRET.

# Interruttore del modulo (variabile pubblica, letta in fase di build):
#   formsubmit = flusso attuale con FormSubmit (predefinito)
#   api        = nuovo endpoint /api/contatti con SMTP Register.it
NEXT_PUBLIC_CONTACT_BACKEND=formsubmit

# Credenziali SMTP della casella che invia (obbligatorie perché l'endpoint funzioni)
SMTP_USER=
SMTP_PASS=
# Chiave per firmare i token antispam, almeno 32 caratteri casuali
CONTACT_FORM_SECRET=

# Facoltative (valori predefiniti verificati)
# SMTP_HOST=authsmtp.securemail.pro
# SMTP_PORT=465
# CONTACT_TO=contatti@dentroleparole.com
# CONTACT_FROM=
